# pi-authentik does not read environment variables for extension configuration.
#
# Use Pi settings instead, for example:
#
# {
#   "pi-authentik": {
#     "authentikHost": "https://auth.example",
#     "providerSlug": "pi",
#     "clientId": "pi-client",
#     "scopes": ["openid", "profile", "email"],
#     "enableOfflineAccess": true,
#     "llmBaseUrl": "https://llm.example/openai/v1",
#     "modelFilters": ["gpt-*", "o3-*"]
#   }
# }
