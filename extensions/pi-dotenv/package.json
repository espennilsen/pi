{
  "name": "@e9n/pi-dotenv",
  "version": "0.1.0",
  "description": "Loads .env files from the working directory into process.env for other extensions",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Espen Nilsen <hi@e9n.dev>",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "package.json",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espennilsen/pi.git",
    "directory": "extensions/pi-dotenv"
  },
  "private": true
