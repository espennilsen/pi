# Pi Agent — local environment overrides
# This file is loaded by pi-dotenv and gitignored.
# Uncomment and fill in the values you need.

# ── pi-webserver ──────────────────────────────────────────────
# PI_WEB_AUTH=password            # Basic auth: "password" or "user:password"
# API_TOKEN=                      # Bearer token for full /api/* access
# API_READ_TOKEN=                 # Bearer token for read-only /api/* access (GET/HEAD)

# ── pi-channels (Telegram) ───────────────────────────────────
# TELEGRAM_BOT_TOKEN=             # Telegram Bot API token from @BotFather

# ── pi-channels (webhooks) ───────────────────────────────────
# WEBHOOK_SECRET=                 # Auth header for outgoing webhook adapter

# ── pi-vault (Obsidian) ──────────────────────────────────────
# OBSIDIAN_API_KEY=               # API key for Obsidian Local REST API plugin

# ── pi-kysely (database) ─────────────────────────────────────
# DATABASE_URL=                   # Generic database URL (fallback)
# PGDATABASE_URL=                 # Postgres connection string
# MYSQL_URL=                      # MySQL connection string
